{
    "name": "yurdika/smartservice-ai",
    "description": "SmartService AI - Aplikasi Pemesanan Jasa & Layanan Terintegrasi AI",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Config\\": "Config/",
            "Controllers\\": "Controllers/",
            "Middleware\\": "Middleware/",
            "Models\\": "Models/",
            "Routes\\": "Routes/",
            "Services\\": "Services/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test:local": "php tests/run_tests.php"
    }
}

